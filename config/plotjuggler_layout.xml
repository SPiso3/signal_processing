<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="signals" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.333;0.333;0.334" count="3">
     <DockArea name="raw">
      <plot mode="TimeSeries" style="Lines">
       <range left="0" right="1" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/sine_signal/raw/data" color="#1f77b4"/>
      </plot>
     </DockArea>
     <DockArea name="derivative">
      <plot mode="TimeSeries" style="Lines">
       <range left="0" right="1" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/sine_signal/derivative/data" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="integral">
      <plot mode="TimeSeries" style="Lines">
       <range left="0" right="1" top="1" bottom="-1"/>
       <limitY/>
       <curve name="/sine_signal/integral/data" color="#2ca02c"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="ROS2 Topic Subscriber">
   <use_header_stamp value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <boolean_strings_to_number value="true"/>
   <remove_suffix_from_strings value="true"/>
   <selected_topics value="/sine_signal/raw;/sine_signal/derivative;/sine_signal/integral"/>
  </plugin>
 </Plugins>
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
 <customMathEquations/>
 <snippets/>
</root>
